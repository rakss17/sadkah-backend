# Copy to .env and fill in real values. Never commit the real .env file.

# Domains Caddy will request Let's Encrypt certs for (must already point at this VPS's IP).
WEB_DOMAIN=sadkah.example.com
API_DOMAIN=api.sadkah.example.com

# Used by the API for JWT Issuer/Audience validation — set to https://<API_DOMAIN>.
API_PUBLIC_URL=https://api.sadkah.example.com

MSSQL_SA_PASSWORD=change-me-to-a-strong-password
JWT_SIGNING_KEY=change-me-to-a-long-random-string

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
